<Window x:Class="GestionCommerciale.WPF.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Commerciale"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <StackPanel Grid.Column="0" Background="#2D2D2D">
            <TextBlock x:Name="TxtUser"
                       Text="Bienvenue"
                       Foreground="White" FontSize="13"
                       FontWeight="SemiBold"
                       Margin="16,24,16,4"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtRole"
                       Text=""
                       Foreground="#AAAAAA" FontSize="11"
                       Margin="16,0,16,24"/>

            <Rectangle Height="1" Fill="#444444" Margin="16,0"/>

            <Button Content="Produits" Style="{StaticResource MenuButton}"
                    Click="BtnProduits_Click" Margin="0,12,0,0"/>
            <Button Content="Stock" Style="{StaticResource MenuButton}"
                    x:Name="BtnStockMenu" Click="BtnStock_Click"/>
            <Button Content="Clients" Style="{StaticResource MenuButton}"
                    Click="BtnClients_Click"/>
            <Button Content="Ventes" Style="{StaticResource MenuButton}"
                    Click="BtnVentes_Click"/>
            <Button Content="Utilisateurs" Style="{StaticResource MenuButton}"
                    x:Name="BtnUsersMenu" Click="BtnUsers_Click"/>
            
            <Rectangle Height="1" Fill="#444444" Margin="16,16"/>

            <Button Content="Déconnexion" Style="{StaticResource MenuButton}"
                    Click="BtnDeconnexion_Click"/>
        </StackPanel>

        <!-- Zone de contenu -->
        <Frame Grid.Column="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="#F5F5F5"/>
    </Grid>
</Window>