<Page x:Class="GestionCommerciale.WPF.Views.StockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gestion du Stock">

    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Page.Resources>

    <Grid Background="#2D2D2D" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Entrée de stock"
                   Foreground="#F5F5F5" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <!-- Formulaire centré -->
        <StackPanel Grid.Row="2" Width="400"
                    HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Produit -->
            <TextBlock Text="Produit" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="CbProduit"
                      Style="{StaticResource InputStyle}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,0,0,16"/>

            <!-- Quantité -->
            <TextBlock Text="Quantité" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="TxtQuantite"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,16"/>

            <!-- Motif -->
            <TextBlock Text="Motif" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="TxtMotif"
                     Style="{StaticResource InputStyle}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24"/>

            <!-- Message erreur/succès -->
            <TextBlock x:Name="TxtMessage"
                       FontSize="13" Margin="0,0,0,16"
                       Visibility="Collapsed"/>

            <!-- Bouton -->
            <Button x:Name="BtnValider"
                    Content="Valider l'entrée"
                    Height="36" FontSize="13"
                    Background="#555555" Foreground="#F5F5F5"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnValider_Click"/>
        </StackPanel>
    </Grid>
</Page>