<Page x:Class="GestionCommerciale.WPF.Views.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gestion des ventes"
      Background="#F5F5F5"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24">

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,16">
                <Button Content="Actualiser"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Click="Actualiser_Click"/>

                <StackPanel>
                    <TextBlock Text="Gestion des ventes"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2D2D2D"/>

                    <TextBlock Text="Créez des ventes et consultez leur historique."
                               Margin="0,6,0,0"
                               Foreground="#666666"/>
                </StackPanel>
            </DockPanel>

            <!-- Création d'une vente -->
            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Nouvelle vente"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#2D2D2D"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Client"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="ClientComboBox"
                              DisplayMemberPath="Name"
                              MinHeight="34"
                              Padding="6"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Produit"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ProductComboBox"
                                  Grid.Column="0"
                                  DisplayMemberPath="Name"
                                  MinHeight="34"
                                  Padding="6"
                                  Margin="0,0,8,0"/>

                        <TextBox x:Name="QuantityTextBox"
                                 Grid.Column="1"
                                 Text="1"
                                 MinHeight="34"
                                 Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <Button Content="Ajouter au panier"
                            HorizontalAlignment="Left"
                            Click="AjouterProduit_Click"/>

                    <TextBlock Text="Articles de la vente"
                               FontWeight="SemiBold"
                               Margin="0,14,0,6"/>

                    <DataGrid x:Name="SaleItemsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="180"
                              Background="White"
                              Foreground="#2D2D2D"
                              RowBackground="White"
                              AlternatingRowBackground="#EEEEEE"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produit"
                                                Binding="{Binding ProductName}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Quantité"
                                                Binding="{Binding Quantity}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prix unitaire"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2} Ar}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Sous-total"
                                                Binding="{Binding Subtotal, StringFormat={}{0:N2} Ar}"
                                                Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,8">

                        <Button Content="Retirer l'article sélectionné"
                                Click="RetirerProduit_Click"/>

                    </StackPanel>

                    <Border Background="#EEEEEE"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,4,0,10">

                        <DockPanel>
                            <TextBlock Text="TOTAL DE LA VENTE"
                                       FontWeight="Bold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TotalTextBlock"
                                       Text="0,00 Ar"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#2D2D2D"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>

                    <Button x:Name="CreateSaleButton"
                            Content="Enregistrer la vente"
                            HorizontalAlignment="Right"
                            Padding="20,10"
                            Click="EnregistrerVente_Click"/>
                </StackPanel>
            </Border>

            <!-- Message -->
            <Border Background="White"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12">

                <TextBlock x:Name="MessageTextBlock"
                           Text="Chargement des ventes..."
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Historique -->
            <TextBlock Text="Historique des ventes"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="#2D2D2D"
                       Margin="0,0,0,8"/>

            <DataGrid x:Name="SalesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="SalesDataGrid_SelectionChanged"
                      Height="300"
                      Background="White"
                      Foreground="#2D2D2D"
                      RowBackground="White"
                      AlternatingRowBackground="#EEEEEE"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° vente"
                                        Binding="{Binding Number}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding Client}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Vendeur"
                                        Binding="{Binding Seller}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Articles"
                                        Binding="{Binding ItemCount}"
                                        Width="0.7*"/>

                    <DataGridTextColumn Header="Montant"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N2} Ar}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Statut"
                                        Binding="{Binding Status}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Détails et annulation -->
            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,12,0,0">

                <StackPanel>
                    <TextBlock Text="Vente sélectionnée"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#2D2D2D"/>

                    <TextBlock x:Name="DetailsTextBlock"
                               Text="Sélectionnez une vente dans le tableau."
                               Margin="0,8"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Motif d'annulation (Admin)"
                               Foreground="#555555"
                               Margin="0,4"/>

                    <TextBox x:Name="CancelReasonTextBox"
                             MaxLength="500"
                             Padding="8"
                             Margin="0,4,0,8"
                             MinHeight="34"/>

                    <Button x:Name="CancelSaleButton"
                            Content="Annuler la vente sélectionnée"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Click="AnnulerVente_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
