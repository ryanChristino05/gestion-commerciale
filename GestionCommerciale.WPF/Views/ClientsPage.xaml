<Page x:Class="GestionCommerciale.WPF.Views.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clients" Background="#F5F5F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Clients"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#2D2D2D" Margin="0,0,0,20"/>

        <!-- Formulaire nouveau client -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#DDDDDD" BorderThickness="1"
                Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Nom *" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" Height="34" FontSize="13" Padding="10,6"
                             Background="White" BorderBrush="#CCCCCC"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Téléphone" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="34" FontSize="13" Padding="10,6"
                             Background="White" BorderBrush="#CCCCCC"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Email" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Height="34" FontSize="13" Padding="10,6"
                             Background="White" BorderBrush="#CCCCCC"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Adresse" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAddress" Height="34" FontSize="13" Padding="10,6"
                             Background="White" BorderBrush="#CCCCCC"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAdd" Content="Ajouter"
                            Height="34" Padding="16,0"
                            Background="#333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Recherche -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="TxtSearch"
                     Height="34" FontSize="13" Padding="10,6"
                     Background="White" BorderBrush="#CCCCCC"
                     VerticalContentAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>

            <Button Grid.Column="1" Content="Rechercher"
                    Height="34" Padding="14,0" Margin="8,0,0,0"
                    Background="#555555" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSearch_Click"/>
        </Grid>

        <!-- Liste -->
        <DataGrid Grid.Row="3" x:Name="ClientsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="White" BorderBrush="#DDDDDD"
                  RowHeight="36" FontSize="13"
                  SelectionMode="Single"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EEEEEE"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#DDDDDD"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>