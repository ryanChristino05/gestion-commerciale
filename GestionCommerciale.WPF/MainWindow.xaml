<Window x:Class="GestionCommerciale.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Commerciale" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Gestion Commerciale"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#2D2D2D" HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="Connectez-vous pour continuer"
                   FontSize="12" Foreground="#888888"
                   HorizontalAlignment="Center" Margin="0,0,0,32"/>

        <!-- Username -->
        <TextBlock Grid.Row="2" Text="Nom d'utilisateur"
                   Foreground="#444444" FontSize="12" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" x:Name="TxtUsername"
                 Height="36" FontSize="13" Padding="10,8"
                 Background="White" BorderBrush="#CCCCCC"
                 Margin="0,0,0,14"/>

        <!-- Password -->
        <TextBlock Grid.Row="4" Text="Mot de passe"
                   Foreground="#444444" FontSize="12" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="5" Orientation="Vertical">
            <PasswordBox x:Name="TxtPassword"
                         Height="36" FontSize="13" Padding="10,8"
                         Background="White" BorderBrush="#CCCCCC"
                         Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtError" Text=""
                       Foreground="#CC0000" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Button x:Name="BtnLogin" Content="Se connecter"
                    Height="40" FontSize="13" FontWeight="SemiBold"
                    Background="#333333" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnLogin_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>